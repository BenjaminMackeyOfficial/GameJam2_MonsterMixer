  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8a33feda7e59fb744bc0781a6f70a0db, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::VampireGeneralController
  waitTime: 0
  ReturnPoint: {x: 0, y: 0, z: 0}
  ableToGive: 0
  patienceLevel: 2
  maxWaitTimeToGetAchievment: 40
  state: 0
  eventPreheader: Andro
  DialougeArivedAtBar:
  - "Hello Handsome \u2026. Be a sport and mix me a Tequila Bloodmoon. what is that
    you ask? Well it\u2019s like a tequila sunrise with a big splash of O positive...
    you know speaking of a big positive O..."
  DialougeUnhappyMidDrinkMake: []
  DialougePleasedMidDrinkMake:
  - "It\u2019s thankless work looking this good when there are so few who appreciate
    it\u2026 you know you could benefit from having me give you a makeover, you have
    such good bone structure and skin tone.  You could do well for yourself as my
    Vassal, I do need someone to run my errands during the day my last assistant\u2026
    didn\u2019t work out but we did part on good terms, we even had lunch\u2026"
  DialougeLeavingBarUpset:
  - "No\u2026 No\u2026this just won\u2019t do\u2026 just no you have ruined my drink.
    You have ruined this party. You have ruined this Halloween. You had best stay
    inside on All Saints day surrounded by a circle of 20 kilos of grain."
  DialougeLeavingBarHappy:
  - "Not bad, not bad could be better but it was a difficult ask, and you are so
    very young\u2026 I will be back to give you another chance to practice your mixology
    on me and see if you can win my affections."
  DialougeLeavingBarPerfect:
  - "My God this is an excellent drink you managed just the right amount of blood,
    it doesn\u2019t get lost in the alcohol and it doesn\u2019t overpower the balance
    of the blend either. Magnificent here is a token of my appreciation! "
