  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::VampireGeneralController
  waitTime: 0
  ReturnPoint: {x: 0, y: 0, z: 0}
  ableToGive: 0
  patienceLevel: 1
  maxWaitTimeToGetAchievment: 50
  state: 0
  eventPreheader: Shy
  DialougeArivedAtBar:
  - Vermouth wiskey lemon B-
  DialougeUnhappyMidDrinkMake: []
  DialougePleasedMidDrinkMake:
  - "Today was my birthday\u2026 no one remembers\u2026 I even went out of my way
    to become a vampire on the same day to make it easier to remember\u2026 but not
    even a single card or handcrafted Epitaph\u2026"
  DialougeLeavingBarUpset:
  - "I did not consider that I could possible feel worse than I already did. But
    this drink, it accomplished that goal \u2026do not leave till sunrise\u2026"
  DialougeLeavingBarHappy:
  - "\u2026 Well why the drink should go any different than this evening.  Thanks,
    maybe next time\u2026"
  DialougeLeavingBarPerfect:
  - "\u2026.. Thanks this is \u2026 actually good\u2026.. Here have this trinket,
    isn\u2019t it just wonderfully macabre and depressing, I can tell you get the
    soul crushing-ness of it all \u2026."
